FROM node:24-alpine AS build

# Install system dependencies including HEIF support
RUN apk add --no-cache \
    fontconfig \
    ttf-liberation \
    libheif \
    libheif-dev \
    vips-dev \
    && fc-cache -f -v

# Set working directory
WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files and prisma schema first
COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Rebuild sharp with HEIF support after installing dependencies
RUN npm rebuild sharp

# Generate Prisma client BEFORE copying all source code
RUN npx prisma generate

# Now copy the rest of the application code
COPY . .

# Build TypeScript to JavaScript
RUN pnpm run build

# Create production image
FROM node:24-alpine

# Install system dependencies including HEIF support for production
RUN apk add --no-cache \
    fontconfig \
    ttf-liberation \
    libheif \
    vips \
    && fc-cache -f -v

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Install pnpm globally in production image
RUN npm install -g pnpm

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S fastify -u 1001 -G nodejs

# Set working directory
WORKDIR /app

# Copy package files and prisma schema
COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/

# Install production dependencies and generate Prisma client
RUN pnpm install --frozen-lockfile && \
    npm rebuild sharp && \
    npx prisma generate

# Copy compiled JavaScript from build stage
COPY --from=build --chown=fastify:nodejs /app/dist ./dist

# Expose the application port
EXPOSE 3000

# Switch to non-root user
USER fastify

# Start the application with the compiled JavaScript
CMD [ "npm", "run", "start:migrate:prod" ]
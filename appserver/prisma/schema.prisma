generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum PropertyStatus {
  Active
  Maintenance
  Archived
}

enum IncidentSeverity {
  Low
  Medium
  High
  Critical
}

enum IncidentStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
  Closed
}

enum SpaceType {
  Kitchen
  LivingRoom
  Bedroom
  Bathroom
  DiningRoom
  Office
  Garage
  Basement
  Hallway
  Exterior
  Attic
  Laundry
  Closet
  Pantry
  Mudroom
  Foyer
  Library
  GameRoom
  HomeTheater
  Gym
  Studio
  GuestRoom
  MasterBedroom
  Balcony
  Patio
  Deck
  Yard
  Driveway
  Other
  Unknown
}

// Models
model User {
  id                Int        @id @default(autoincrement()) @map("user_id")
  auth0Id           String     @unique @map("auth0_id")
  email             String     @unique
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  phone             String?
  profilePictureUrl String?    @map("profile_picture_url")
  lastLogin         DateTime?  @map("last_login") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  isDeleted         Boolean    @default(false)

  // Invitation system fields
  isPlaceholder     Boolean    @default(false) @map("is_placeholder")
  invitationToken   String?    @unique @map("invitation_token")
  invitedById       Int?       @map("invited_by_id")
  expiresAt         DateTime?  @map("expires_at") @db.Timestamptz(6)

  // Relations
  properties        Property[]
  invitedBy         User?      @relation("UserInvitations", fields: [invitedById], references: [id])
  invitedUsers      User[]     @relation("UserInvitations")

  @@index([isPlaceholder])
  @@index([invitationToken])
  @@map("users")
}

model Property {
  id                Int             @id @default(autoincrement()) @map("property_id")
  userId            Int             @map("user_id")
  address           String
  city              String
  state             String?
  zipCode           String?         @map("zip_code")
  country           String
  latitude          Decimal         @db.Decimal(10, 7)
  longitude         Decimal         @db.Decimal(10, 7)
  status            PropertyStatus
  imageUrl          String?         @map("image_url")
  incidentCount     Int             @default(0) @map("incident_count")
  openIncidentCount Int             @default(0) @map("open_incident_count")
  lastIncidentAt    DateTime?       @map("last_incident_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relations
  incidents         Incident[]
  inspections       Inspection[]
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaces            PropertySpace[]

  @@index([userId])
  @@index([status])
  @@index([country, city])
  @@index([updatedAt(sort: Desc)])
  @@map("properties")
}

model Inspection {
  id             Int             @id @default(autoincrement()) @map("inspection_id")
  propertyId     Int             @map("property_id")
  title          String          @default("Inspection")
  description    String?
  inspectionDate DateTime        @map("inspection_date") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relations
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  photos         PropertyImage[]

  @@index([propertyId])
  @@index([inspectionDate])
  @@map("inspections")
}

model PropertySpace {
  id              Int                @id @default(autoincrement()) @map("space_id")
  propertyId      Int                @map("property_id")
  name            String?
  type            SpaceType          @default(Unknown)
  aiGenerated     Boolean            @default(true) @map("ai_generated")
  featureVector   Json?              @map("feature_vector")
  confidenceScore Decimal?           @map("confidence_score") @db.Decimal(5, 4)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relations
  images          PropertyImage[]
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  objectLabels    SpaceObjectLabel[]

  @@index([propertyId])
  @@index([type])
  @@map("property_spaces")
}

model SpaceObjectLabel {
  id         Int           @id @default(autoincrement()) @map("label_id")
  spaceId    Int           @map("space_id")
  name       String
  confidence Decimal       @map("confidence_score") @db.Decimal(5, 4)
  category   String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  space      PropertySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([name])
  @@index([category])
  @@map("space_object_labels")
}

model PropertyImage {
  id              Int                @id @default(autoincrement()) @map("image_id")
  imageUrl        String             @map("image_url")
  caption         String?
  takenAt         DateTime           @map("taken_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  featureVector   Json?              @map("feature_vector")
  inspectionId    Int?               @map("inspection_id")
  metadata        Json?
  spaceId         Int?               @map("space_id")
  incidentId      Int?               @map("incident_id")

  // Relations
  detectedChanges ImageChange[]
  objectLabels    ImageObjectLabel[]
  similarImages   ImageSimilarity[]  @relation("BaseImage")
  comparedTo      ImageSimilarity[]  @relation("ComparedImage")
  incident        Incident?          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  inspection      Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  space           PropertySpace?     @relation(fields: [spaceId], references: [id])

  @@index([inspectionId])
  @@index([spaceId])
  @@index([incidentId])
  @@index([takenAt])
  @@map("property_images")
}

model ImageSimilarity {
  id              Int           @id @default(autoincrement()) @map("similarity_id")
  baseImageId     Int           @map("base_image_id")
  comparedImageId Int           @map("compared_image_id")
  similarityScore Decimal       @map("similarity_score") @db.Decimal(5, 4)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  baseImage       PropertyImage @relation("BaseImage", fields: [baseImageId], references: [id], onDelete: Cascade)
  comparedImage   PropertyImage @relation("ComparedImage", fields: [comparedImageId], references: [id], onDelete: Cascade)

  @@unique([baseImageId, comparedImageId])
  @@index([baseImageId])
  @@index([comparedImageId])
  @@index([similarityScore])
  @@map("image_similarities")
}

model ImageChange {
  id              Int           @id @default(autoincrement()) @map("change_id")
  imageId         Int           @map("image_id")
  changeType      String        @map("change_type")
  description     String?
  boundingBox     Json?         @map("bounding_box")
  confidenceScore Decimal       @map("confidence_score") @db.Decimal(5, 4)
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relations
  image           PropertyImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([changeType])
  @@index([verified])
  @@map("image_changes")
}

model ImageObjectLabel {
  id          Int           @id @default(autoincrement()) @map("label_id")
  imageId     Int           @map("image_id")
  name        String
  confidence  Decimal       @map("confidence_score") @db.Decimal(5, 4)
  category    String?
  boundingBox Json?         @map("bounding_box")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  image       PropertyImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([name])
  @@index([category])
  @@map("image_object_labels")
}

model Incident {
  id              Int                   @id @default(autoincrement()) @map("incident_id")
  propertyId      Int                   @map("property_id")
  incidentType    String                @map("incident_type")
  description     String
  reportedAt      DateTime              @map("reported_at") @db.Timestamptz(6)
  resolvedAt      DateTime?             @map("resolved_at") @db.Timestamptz(6)
  severity        IncidentSeverity
  status          IncidentStatus        @default(Open)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  aiClassified    Boolean               @default(false) @map("ai_classified")
  featureVector   Json?                 @map("feature_vector")
  spaceType       SpaceType?            @map("space_type")
  labeledImageUrl String?               @map("labeled_image_url")

  // Relations
  objectLabels    IncidentObjectLabel[]
  property        Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images          PropertyImage[]

  @@index([propertyId])
  @@index([status])
  @@index([severity])
  @@index([reportedAt(sort: Desc)])
  @@index([incidentType, status])
  @@index([spaceType])
  @@map("incidents")
}

model IncidentObjectLabel {
  id         Int      @id @default(autoincrement()) @map("label_id")
  incidentId Int      @map("incident_id")
  name       String
  confidence Decimal  @map("confidence_score") @db.Decimal(5, 4)
  category   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([name])
  @@index([category])
  @@map("incident_object_labels")
}
